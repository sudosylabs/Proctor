{
  "name": "@sudosylabs/proctor-webapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:watch": "vite build --watch",
    "brand-assets:check": "node ./scripts/check-brand-assets.mjs",
    "design-system:generate": "node ./scripts/generate-design-system.mjs",
    "design-system:check": "node ./scripts/check-design-system.mjs && node --test ./design-system/index.contract.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "api:generate": "openapi-typescript ../server/openapi.json -o src/api/generated/schema.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/generated/schema.ts",
    "i18n:generate": "node ./scripts/generate-i18n.mjs",
    "i18n:check": "npm run i18n:generate && git diff --exit-code -- src/generated/i18n/catalogs.ts",
    "routes:generate": "node ./scripts/generate-routes.mjs",
    "routes:check": "npm run routes:generate && git diff --exit-code -- src/app/routes.ts",
    "verify": "npm run brand-assets:check && npm run design-system:check && npm run api:check && npm run i18n:check && npm run routes:check && npm run typecheck && npm run lint && npm test",
    "check": "npm run verify && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
