<!--
Template properties (templates.Properties):
  .Copy.Subject — localized message subject
  .Copy.Preheader — localized inbox preview
  .Copy.Heading — localized visible heading
  .Copy.Body — localized primary message
  .Copy.ActionLabel — localized action label; empty when no action is offered
  .Copy.Footer — localized closing and safety copy
  .ActionURL — validated HTTPS action URL; empty when no action is offered
  .ClassTransition.PreviousClassDisplayName — bounded source Class display name
  .ClassTransition.ClassDisplayName — bounded destination Class display name
  .ClassTransition.StartsAt — UTC RFC 3339 transfer time
  .ClassTransition.EndsAt — UTC RFC 3339 destination end or localized open end
  .ClassTransition.Timezone — localized explicit timezone label
-->
<mjml>
  <mj-head>
    <mj-title>{{.Copy.Subject}}</mj-title>
    <mj-preview>{{.Copy.Preheader}}</mj-preview>
    <mj-include path="./partials/foundation-head.mjml" />
  </mj-head>
  <mj-body background-color="#f4f5f7">
    <mj-include path="./partials/foundation-message.mjml" />
    <mj-section background-color="#ffffff" padding="0 24px 24px"><mj-column><mj-text><strong>{{.Copy.ClassTransition.PreviousClassLabel}}:</strong> {{.ClassTransition.PreviousClassDisplayName}}<br /><strong>{{.Copy.ClassTransition.NewClassLabel}}:</strong> {{.ClassTransition.ClassDisplayName}}<br /><strong>{{.Copy.ClassTransition.StartsAtLabel}}:</strong> {{.ClassTransition.StartsAt}}<br /><strong>{{.Copy.ClassTransition.EndsAtLabel}}:</strong> {{.ClassTransition.EndsAt}}<br /><strong>{{.Copy.ClassTransition.TimezoneLabel}}:</strong> {{.ClassTransition.Timezone}}</mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
