<mj-section background-color="#ffffff" padding="0 56px 48px">
  <mj-column>
    <mj-table cellpadding="0" cellspacing="0" width="100%" padding="0">
      <tr>
        <td style="padding:16px 0;border-bottom:1px solid #E4E4E7">
          <div style="color:#5C5C5C;font-size:13px;line-height:18px;padding:0 0 4px;font-family:IBM Plex Sans, Helvetica Neue, Helvetica, Arial, sans-serif">{{.Copy.ResultRelease.ExamLabel}}</div>
          <div style="color:#161616;font-size:16px;line-height:24px;word-break:break-word;font-family:IBM Plex Sans, Helvetica Neue, Helvetica, Arial, sans-serif">{{.ResultRelease.ExamTitle}}</div>
        </td>
      </tr>
      <tr>
        <td style="padding:16px 0;border-bottom:1px solid #E4E4E7">
          <div style="color:#5C5C5C;font-size:13px;line-height:18px;padding:0 0 4px;font-family:IBM Plex Sans, Helvetica Neue, Helvetica, Arial, sans-serif">{{.Copy.ResultRelease.ReleasedAtLabel}}</div>
          <div style="color:#161616;font-size:16px;line-height:24px;font-variant-numeric:tabular-nums;font-family:IBM Plex Sans, Helvetica Neue, Helvetica, Arial, sans-serif">{{.ResultRelease.ReleasedAt}}</div>
        </td>
      </tr>
      <tr>
        <td style="padding:16px 0">
          <div style="color:#5C5C5C;font-size:13px;line-height:18px;padding:0 0 4px;font-family:IBM Plex Sans, Helvetica Neue, Helvetica, Arial, sans-serif">{{.Copy.ResultRelease.TimezoneLabel}}</div>
          <div style="color:#161616;font-size:16px;line-height:24px;font-family:IBM Plex Sans, Helvetica Neue, Helvetica, Arial, sans-serif">{{.ResultRelease.Timezone}}</div>
        </td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>
