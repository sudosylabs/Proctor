<mj-section background-color="#ffffff" padding="0 24px 8px">
  <mj-column>
    <mj-table cellpadding="0" cellspacing="0" width="100%" padding="0">
      <tr>
        <th align="left" style="padding:6px 16px 6px 0;color:#5C5C5C;font-weight:400;font-size:14px;line-height:20px;vertical-align:top;width:120px">{{.Copy.SittingSchedule.ExamLabel}}</th>
        <td style="padding:6px 0;color:#161616;font-size:14px;line-height:20px;vertical-align:top;word-break:break-word">{{.SittingSchedule.ExamTitle}}</td>
      </tr>
      <tr>
        <th align="left" style="padding:6px 16px 6px 0;color:#5C5C5C;font-weight:400;font-size:14px;line-height:20px;vertical-align:top;width:120px">{{.Copy.SittingSchedule.ClassLabel}}</th>
        <td style="padding:6px 0;color:#161616;font-size:14px;line-height:20px;vertical-align:top;word-break:break-word">{{.SittingSchedule.ClassDisplayName}}</td>
      </tr>
      <tr>
        <th align="left" style="padding:6px 16px 6px 0;color:#5C5C5C;font-weight:400;font-size:14px;line-height:20px;vertical-align:top;width:120px">{{.Copy.SittingSchedule.StartsAtLabel}}</th>
        <td style="padding:6px 0;color:#161616;font-size:14px;line-height:20px;vertical-align:top;font-variant-numeric:tabular-nums">{{.SittingSchedule.StartsAt}}</td>
      </tr>
      <tr>
        <th align="left" style="padding:6px 16px 6px 0;color:#5C5C5C;font-weight:400;font-size:14px;line-height:20px;vertical-align:top;width:120px">{{.Copy.SittingSchedule.EndsAtLabel}}</th>
        <td style="padding:6px 0;color:#161616;font-size:14px;line-height:20px;vertical-align:top;font-variant-numeric:tabular-nums">{{.SittingSchedule.EndsAt}}</td>
      </tr>
      <tr>
        <th align="left" style="padding:6px 16px 6px 0;color:#5C5C5C;font-weight:400;font-size:14px;line-height:20px;vertical-align:top;width:120px">{{.Copy.SittingSchedule.TimezoneLabel}}</th>
        <td style="padding:6px 0;color:#161616;font-size:14px;line-height:20px;vertical-align:top">{{.SittingSchedule.Timezone}}</td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>
