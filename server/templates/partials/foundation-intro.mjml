<mj-section background-color="#ffffff" padding="52px 56px 48px">
  <mj-column>
    <mj-image src="cid:proctor-lockup-9867b48826bf314b6729f73941d053922d7baa7f5120894241ce197c219b8d66@proctor" alt="Proctor" align="left" width="200px" height="39px" padding="0 0 40px" />
    <mj-text font-size="26px" line-height="34px" font-weight="500" padding="0 0 24px">
      {{.Copy.Heading}}
    </mj-text>
    <mj-text padding="0">
      {{.Copy.Body}}
    </mj-text>
    <mj-raw>{{if .ActionURL}}</mj-raw>
    <mj-button href="{{.ActionURL}}" align="left">
      {{.Copy.ActionLabel}}
    </mj-button>
    <mj-text color="#5C5C5C" font-size="13px" line-height="20px" padding="16px 0 0">
      <a href="{{.ActionURL}}">{{.ActionURL}}</a>
    </mj-text>
    <mj-raw>{{end}}</mj-raw>
  </mj-column>
</mj-section>
