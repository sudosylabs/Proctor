<mj-section background-color="#ffffff" padding="0 24px 8px">
  <mj-column>
    <mj-table cellpadding="0" cellspacing="0" width="100%" padding="0">
      <tr>
        <th align="left" style="padding:6px 16px 6px 0;color:#5C5C5C;font-weight:400;font-size:14px;line-height:20px;vertical-align:top;width:120px">{{.Copy.ClassTransition.PreviousClassLabel}}</th>
        <td style="padding:6px 0;color:#161616;font-size:14px;line-height:20px;vertical-align:top;word-break:break-word">{{.ClassTransition.PreviousClassDisplayName}}</td>
      </tr>
      <tr>
        <th align="left" style="padding:6px 16px 6px 0;color:#5C5C5C;font-weight:400;font-size:14px;line-height:20px;vertical-align:top;width:120px">{{.Copy.ClassTransition.NewClassLabel}}</th>
        <td style="padding:6px 0;color:#161616;font-size:14px;line-height:20px;vertical-align:top;word-break:break-word">{{.ClassTransition.ClassDisplayName}}</td>
      </tr>
      <tr>
        <th align="left" style="padding:6px 16px 6px 0;color:#5C5C5C;font-weight:400;font-size:14px;line-height:20px;vertical-align:top;width:120px">{{.Copy.ClassTransition.StartsAtLabel}}</th>
        <td style="padding:6px 0;color:#161616;font-size:14px;line-height:20px;vertical-align:top;font-variant-numeric:tabular-nums">{{.ClassTransition.StartsAt}}</td>
      </tr>
      <tr>
        <th align="left" style="padding:6px 16px 6px 0;color:#5C5C5C;font-weight:400;font-size:14px;line-height:20px;vertical-align:top;width:120px">{{.Copy.ClassTransition.EndsAtLabel}}</th>
        <td style="padding:6px 0;color:#161616;font-size:14px;line-height:20px;vertical-align:top;font-variant-numeric:tabular-nums">{{.ClassTransition.EndsAt}}</td>
      </tr>
      <tr>
        <th align="left" style="padding:6px 16px 6px 0;color:#5C5C5C;font-weight:400;font-size:14px;line-height:20px;vertical-align:top;width:120px">{{.Copy.ClassTransition.TimezoneLabel}}</th>
        <td style="padding:6px 0;color:#161616;font-size:14px;line-height:20px;vertical-align:top">{{.ClassTransition.Timezone}}</td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>
