{
  "version": 1,
  "server": {
    "listen_address": "127.0.0.1:8065",
    "public_url": "http://localhost:8065",
    "read_header_timeout": "10s",
    "read_timeout": "30s",
    "write_timeout": "30s",
    "idle_timeout": "2m",
    "shutdown_timeout": "15s",
    "max_header_bytes": 1048576,
    "max_body_bytes": 1048576
  },
  "log": {
    "max_field_bytes": 16384,
    "targets": [
      {
        "name": "console",
        "type": "console",
        "level": "info",
        "format": "text"
      }
    ]
  }
}
