{
  "version": 1,
  "server": {
    "listen_address": "127.0.0.1:8065",
    "public_url": "http://localhost:8065",
    "read_header_timeout": "10s",
    "read_timeout": "30s",
    "write_timeout": "30s",
    "idle_timeout": "2m",
    "shutdown_timeout": "15s",
    "max_header_bytes": 1048576,
    "max_body_bytes": 1048576
  },
  "database": {
    "data_source": "postgres://proctor:proctor@127.0.0.1:15432/proctor?sslmode=disable",
    "max_open_connections": 50,
    "max_idle_connections": 10,
    "connection_max_lifetime": "1h",
    "connection_max_idle_time": "5m",
    "query_timeout": "10s",
    "migration_timeout": "1m"
  },
  "cache": {
    "backend": "memory",
    "namespace": "proctor",
    "redis": {
      "addresses": ["127.0.0.1:6379"],
      "database": 0,
      "tls": false,
      "connect_timeout": "5s"
    }
  },
  "cluster": {
    "backend": "local",
    "node_id": "local",
    "memberlist": {
      "bind_address": "127.0.0.1:7946",
      "advertise_address": "127.0.0.1:7946",
      "encryption_key": "",
      "seed_addresses": [],
      "discovery_ttl": "30s",
      "discovery_heartbeat": "10s",
      "protocol_min": 1,
      "protocol_max": 1,
      "allow_public_bind": false
    }
  },
  "mail": {
    "enabled": false,
    "backend": "smtp",
    "from_address": "no-reply@localhost",
    "from_name": "Proctor",
    "smtp": {
      "address": "127.0.0.1:1025",
      "security": "none",
      "authentication": "none",
      "timeout": "10s",
      "message_id_domain": "localhost",
      "max_message_bytes": 26214400,
      "max_recipients": 100
    },
    "secret_sealing": {
      "encryption_key": "",
      "decryption_keys": []
    }
  },
  "vfs": {
    "backend": "local",
    "local": {
      "root": "./data"
    },
    "s3": {
      "endpoint": "",
      "bucket": "",
      "secure": true
    }
  },
  "authentication": {
    "bootstrap": {
      "secret": "",
      "development_mode": true
    },
    "password": {
      "minimum_length": 12,
      "maximum_length": 128,
      "argon_memory_kib": 65536,
      "argon_iterations": 3,
      "argon_parallelism": 2,
      "argon_salt_bytes": 16,
      "argon_key_bytes": 32
    },
    "sessions": {
      "access_ttl": "15m",
      "refresh_ttl": "720h",
      "idle_ttl": "168h",
      "absolute_ttl": "720h",
      "activity_update_interval": "5m",
      "maximum_per_user": 10
    },
    "recent_authentication_ttl": "15m",
    "login_rate_limit": {
      "window": "1m",
      "maximum_attempts": 10,
      "maximum_source_attempts": 1000
    },
    "account_recovery": {
      "email_verification_ttl": "24h",
      "password_reset_ttl": "1h",
      "rate_limit": {
        "window": "15m",
        "maximum_attempts": 3,
        "maximum_source_attempts": 100
      }
    },
    "personal_access_tokens": {
      "minimum_lifetime": "1h",
      "maximum_lifetime": "2160h",
      "last_used_update_interval": "5m",
      "maximum_per_user": 50
    },
    "mfa": {
      "enabled": false,
      "issuer": "Proctor",
      "encryption_key": "",
      "decryption_keys": [],
      "setup_ttl": "10m",
      "recovery_code_count": 10
    },
    "external": {
      "login_state_ttl": "10m",
      "providers": []
    }
  },
  "log": {
    "max_field_bytes": 16384,
    "targets": [
      {
        "name": "console",
        "type": "console",
        "level": "info",
        "format": "text"
      }
    ]
  }
}
