{
  "name": "@sudosylabs/proctor-docs",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "prestart": "npm run generate:openapi",
    "build": "docusaurus build",
    "prebuild": "npm run generate:openapi",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "generate:openapi": "node scripts/sync-openapi.mjs",
    "audit:openapi": "node scripts/audit-openapi.mjs",
    "test:openapi-audit": "node --test scripts/openapi-audit.test.mjs",
    "validate": "node scripts/validate-content.mjs && npm run test:openapi-audit && npm run audit:openapi",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  },
  "overrides": {
    "serialize-javascript": "7.1.0",
    "uuid": "11.1.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
