root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{go,sh}]
indent_style = tab
indent_size = 8

[build/scripts/*]
indent_style = tab
indent_size = 8

[{Makefile,*.mk}]
indent_style = tab
indent_size = 8

[*.{css,js,json,jsonc,jsx,lua,mjs,mdx,scss,ts,tsx,yaml,yml}]
indent_style = space
indent_size = 2

[{go.mod,go.sum,go.work,go.work.sum}]
indent_style = tab
indent_size = 8

[Dockerfile*]
indent_style = space
indent_size = 4

[*.{html,mjml,svg}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 4
