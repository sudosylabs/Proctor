# Copy this file to proctor.env with mode 0600. Prefer secret files or your
# deployment secret manager where supported. Never commit the populated file.
PROCTOR_DATABASE_DATA_SOURCE=postgres://proctor:replace-me@database.example.edu:5432/proctor?sslmode=verify-full
PROCTOR_CACHE_BACKEND=redis
PROCTOR_CACHE_REDIS_ADDRESSES=redis.example.edu:6379
PROCTOR_VFS_BACKEND=s3
PROCTOR_VFS_S3_ENDPOINT=s3.example.edu
PROCTOR_VFS_S3_ACCESS_KEY=replace-me
PROCTOR_VFS_S3_SECRET_KEY=replace-me
PROCTOR_VFS_S3_BUCKET=proctor
PROCTOR_VFS_S3_REGION=us-east-1
PROCTOR_VFS_S3_SECURE=true

# Active-active example; give every host a different stable node ID and
# advertise address. Supply a real base64 Memberlist key through a protected
# environment file or deployment secret manager.
# PROCTOR_CLUSTER_BACKEND=memberlist
# PROCTOR_CLUSTER_NODE_ID=proctor-node-a
# PROCTOR_CLUSTER_MEMBERLIST_BIND_ADDRESS=0.0.0.0:7946
# PROCTOR_CLUSTER_MEMBERLIST_ADVERTISE_ADDRESS=10.0.0.11:7946
# PROCTOR_CLUSTER_MEMBERLIST_ALLOW_PUBLIC_BIND=true
# PROCTOR_CLUSTER_MEMBERLIST_ENCRYPTION_KEY=replace-with-base64-key
# PROCTOR_CLUSTER_MEMBERLIST_DECRYPTION_KEYS=
# PROCTOR_CLUSTER_MEMBERLIST_SEED_ADDRESSES=10.0.0.12:7946,10.0.0.13:7946

# The defaults probe plain HTTP on the application listener. For built-in TLS:
# PROCTOR_HEALTHCHECK_URL=https://127.0.0.1:8065/health/ready
# PROCTOR_HEALTHCHECK_SERVER_NAME=proctor.example.edu
# PROCTOR_HEALTHCHECK_CA_FILE=/run/secrets/proctor/issuer-ca.pem
