# Only the maintainer image builds from the repository root, and it needs only
# the repository-pinned Go tool manifests. Everything else stays outside the
# build context so ignored operator/developer material cannot influence or
# reach the builder. The runtime image builds from a packaged directory below
# .build/container or the release job's extracted archives, never this tree.
*
!build/
build/**
!build/tools/
!build/tools/go.mod
!build/tools/go.sum
!build/tools/gopls/
!build/tools/gopls/go.mod
!build/tools/gopls/go.sum
