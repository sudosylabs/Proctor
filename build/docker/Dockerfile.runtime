# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
ARG GO_IMAGE
FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS webapp
WORKDIR /src
COPY webapp/package.json webapp/package-lock.json ./webapp/
RUN --mount=type=cache,target=/root/.npm cd webapp && npm ci
COPY webapp ./webapp
COPY server/openapi.json ./server/openapi.json
COPY server/i18n ./server/i18n
ARG VERSION=dev
ARG COMMIT=unknown
ARG SOURCE_DATE_EPOCH=0
RUN cd webapp \
    && PROCTOR_BUILD_VERSION="$VERSION" PROCTOR_BUILD_COMMIT="$COMMIT" SOURCE_DATE_EPOCH="$SOURCE_DATE_EPOCH" npm run build

FROM ${GO_IMAGE} AS server
WORKDIR /src
COPY go.work go.work.sum ./
COPY packages/cache/go.mod packages/cache/go.sum ./packages/cache/
COPY packages/mail/go.mod ./packages/mail/go.mod
COPY packages/vfs/go.mod packages/vfs/go.sum ./packages/vfs/
COPY server/go.mod server/go.sum ./server/
RUN --mount=type=cache,target=/go/pkg/mod \
    go list -m -f '{{if and (not .Main) (not .Replace)}}{{.Path}}{{end}}' all \
      | sed '/^$/d' \
      | xargs go mod download
COPY packages ./packages
COPY server ./server
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -buildvcs=false -mod=readonly -trimpath \
      -ldflags "-buildid= -s -w -X github.com/sudosylabs/proctor/server/app.Version=$VERSION -X github.com/sudosylabs/proctor/server/app.Commit=$COMMIT -X github.com/sudosylabs/proctor/server/app.BuildTime=$BUILD_TIME" \
      -o /out/proctor ./server/cmd/proctor \
    && CGO_ENABLED=0 GOOS=linux go build -buildvcs=false -mod=readonly -trimpath \
      -ldflags "-buildid= -s -w" -o /out/proctor-healthcheck ./server/cmd/proctor-healthcheck

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
WORKDIR /opt/proctor
COPY --from=server --chown=65532:65532 /out/proctor /out/proctor-healthcheck ./
COPY --from=webapp --chown=65532:65532 /src/webapp/dist ./webapp/dist
COPY --chown=65532:65532 server/config/config.example.json ./config/config.example.json
COPY --chown=65532:65532 server/config/examples ./config/examples
COPY --chown=65532:65532 server/LICENSE server/NOTICE ./
USER 65532:65532
EXPOSE 8065 8067 7946/tcp 7946/udp
ENTRYPOINT ["/opt/proctor/proctor"]
CMD ["serve", "--config", "/etc/proctor/config.json"]
