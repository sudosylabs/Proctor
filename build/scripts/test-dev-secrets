#!/bin/sh
# Copyright 2026 SudoSylabs
# SPDX-License-Identifier: AGPL-3.0-only

set -eu

if [ "$#" -ne 2 ]; then
	printf 'usage: test-dev-secrets DEV_SECRETS_SCRIPT OPENSSL_CONFIG\n' >&2
	exit 2
fi

dev_secrets_script=$1
openssl_config=$2
test_directory=$(mktemp -d "${TMPDIR:-/tmp}/proctor-dev-secrets-test.XXXXXX")
trap 'rm -rf "$test_directory"' EXIT INT TERM

"$dev_secrets_script" "$test_directory/secrets" "$openssl_config"
cp "$test_directory/secrets/environment" "$test_directory/original-environment"

rm "$test_directory/secrets/metrics-token"
"$dev_secrets_script" "$test_directory/secrets" "$openssl_config"

cmp "$test_directory/original-environment" "$test_directory/secrets/environment"
projected_token=$(sed -n 's/^PROCTOR_METRICS_BEARER_TOKEN=//p' "$test_directory/secrets/environment")
actual_token=$(sed -n '1p' "$test_directory/secrets/metrics-token")
[ "$actual_token" = "$projected_token" ]
