#!/bin/sh
# Copyright 2026 SudoSylabs
# SPDX-License-Identifier: AGPL-3.0-only

set -eu

if [ "$#" -lt 2 ]; then
	printf 'usage: %s ENV_FILE COMMAND [ARG...]\n' "$0" >&2
	exit 2
fi

environment_file=$1
shift

if [ ! -f "$environment_file" ]; then
	printf 'missing development environment file: %s; run make dev-state\n' "$environment_file" >&2
	exit 1
fi
if [ "$#" -eq 0 ]; then
	printf 'missing command\n' >&2
	exit 2
fi

set -a
# This mode-0600 file is generated by build/scripts/dev-secrets and contains
# shell-safe assignments for the local-only development environment.
. "$environment_file"
set +a

exec "$@"
