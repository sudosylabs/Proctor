#!/bin/sh
# Copyright 2026 SudoSylabs
# SPDX-License-Identifier: AGPL-3.0-only

set -eu

if [ "$#" -ne 1 ]; then
	printf 'usage: %s CHECK_GO_TOOLS_SCRIPT\n' "$0" >&2
	exit 2
fi

script=$1
fixture=$(mktemp -d "${TMPDIR:-/tmp}/proctor-check-go-tools spaced.XXXXXX")
trap 'rm -rf "$fixture"' EXIT HUP INT TERM

mkdir -p "$fixture/bin" "$fixture/tools/gopls"
cat >"$fixture/tools/go.mod" <<'EOF'
module example.test/tools

go 1.25.0

require (
	github.com/go-delve/delve v1.27.1
	github.com/golangci/golangci-lint/v2 v2.12.2
	golang.org/x/tools v0.49.0
	golang.org/x/vuln v1.7.0
)
EOF
cat >"$fixture/tools/gopls/go.mod" <<'EOF'
module example.test/tools/gopls

go 1.25.0

require golang.org/x/tools/gopls v0.21.1
EOF

for binary in dlv golangci-lint goimports gopls govulncheck; do
	cat >"$fixture/bin/$binary" <<'EOF'
#!/bin/sh
exit 0
EOF
	chmod +x "$fixture/bin/$binary"
done
cat >"$fixture/bin/pprof" <<'EOF'
#!/bin/sh
[ "${1-}" = -h ]
EOF
cat >"$fixture/bin/trace" <<'EOF'
#!/bin/sh
[ "${1-}" = -h ] && exit 2
exit 1
EOF
chmod +x "$fixture/bin/pprof" "$fixture/bin/trace"

cat >"$fixture/fake-go" <<'EOF'
#!/bin/sh
set -eu
if [ "${1-}" = env ] && [ "${2-}" = GOVERSION ]; then
	printf 'go1.25.13\n'
	exit 0
fi
binary=${3##*/}
case "$binary" in
	dlv) module=github.com/go-delve/delve; version=v1.27.1 ;;
	golangci-lint) module=github.com/golangci/golangci-lint/v2; version=v2.12.2 ;;
	goimports) module=golang.org/x/tools; version=v0.49.0 ;;
	gopls) module=golang.org/x/tools/gopls; version=v0.21.1 ;;
	govulncheck) module=golang.org/x/vuln; version=v1.7.0 ;;
	pprof) printf '%s: go1.25.13\npath\tcmd/pprof\n' "$3"; exit 0 ;;
	trace) printf '%s: go1.25.13\npath\tcmd/trace\n' "$3"; exit 0 ;;
	*) exit 1 ;;
esac
printf 'path\texample.test/%s\nmod\t%s\t%s\th1:test\n' "$binary" "$module" "$version"
EOF
chmod +x "$fixture/fake-go"

"$script" "$fixture/tools" "$fixture/bin" "$fixture/fake-go" >/dev/null

rm "$fixture/bin/gopls"
if "$script" "$fixture/tools" "$fixture/bin" "$fixture/fake-go" >/dev/null 2>&1; then
	printf 'expected a missing tool to fail validation\n' >&2
	exit 1
fi

cat >"$fixture/bin/gopls" <<'EOF'
#!/bin/sh
exit 0
EOF
chmod +x "$fixture/bin/gopls"
cat >"$fixture/bin/pprof" <<'EOF'
#!/bin/sh
exit 1
EOF
chmod +x "$fixture/bin/pprof"
if "$script" "$fixture/tools" "$fixture/bin" "$fixture/fake-go" >/dev/null 2>&1; then
	printf 'expected a broken standard-tool smoke check to fail validation\n' >&2
	exit 1
fi

printf 'check-go-tools tests passed\n'
