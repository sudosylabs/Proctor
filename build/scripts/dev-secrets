#!/bin/sh
# Copyright 2026 SudoSylabs
# SPDX-License-Identifier: AGPL-3.0-only

set -eu

destination=$1
openssl_config=$2

umask 077
mkdir -p "$destination"

environment_file="$destination/environment"
token_file="$destination/metrics-token"
certificate_file="$destination/metrics-certificate.pem"
private_key_file="$destination/metrics-private-key.pem"

if [ ! -f "$environment_file" ]; then
	bootstrap_secret=$(openssl rand -hex 32)
	metrics_token=$(openssl rand -hex 32)
	mail_key=$(openssl rand -base64 32 | tr -d '\n')
	mfa_key=$(openssl rand -base64 32 | tr -d '\n')
	memberlist_key=$(openssl rand -base64 32 | tr -d '\n')
	temporary_environment=$(mktemp "$destination/.environment.XXXXXX")
	{
		printf 'PROCTOR_AUTHENTICATION_BOOTSTRAP_SECRET=%s\n' "$bootstrap_secret"
		printf 'PROCTOR_METRICS_BEARER_TOKEN=%s\n' "$metrics_token"
		printf 'PROCTOR_MAIL_SECRET_SEALING_ENCRYPTION_KEY=%s\n' "$mail_key"
		printf 'PROCTOR_AUTHENTICATION_MFA_ENCRYPTION_KEY=%s\n' "$mfa_key"
		printf 'PROCTOR_CLUSTER_MEMBERLIST_ENCRYPTION_KEY=%s\n' "$memberlist_key"
	} >"$temporary_environment"
	mv "$temporary_environment" "$environment_file"
fi

# The environment file is the secret authority. The Prometheus token file is
# only a projection for credentials_file and must be recoverable without
# rotating MFA, mail, bootstrap, or Memberlist keys retained by development
# state.
metrics_token=$(sed -n 's/^PROCTOR_METRICS_BEARER_TOKEN=//p' "$environment_file")
case "$metrics_token" in
	''|*[!0-9a-f]*)
		printf 'generated environment contains an invalid metrics bearer token\n' >&2
		exit 1
		;;
esac
if [ "${#metrics_token}" -ne 64 ]; then
	printf 'generated environment contains an invalid metrics bearer token\n' >&2
	exit 1
fi
temporary_token=$(mktemp "$destination/.metrics-token.XXXXXX")
printf '%s\n' "$metrics_token" >"$temporary_token"
if [ ! -f "$token_file" ] || ! cmp -s "$temporary_token" "$token_file"; then
	mv "$temporary_token" "$token_file"
else
	rm -f "$temporary_token"
fi

certificate_valid=false
if [ -f "$certificate_file" ] && [ -f "$private_key_file" ] \
	&& openssl x509 -checkend 86400 -noout -in "$certificate_file" >/dev/null 2>&1 \
	&& openssl x509 -text -noout -in "$certificate_file" | grep -q 'CA:TRUE' \
	&& [ "$(openssl x509 -noout -modulus -in "$certificate_file" 2>/dev/null)" = "$(openssl rsa -noout -modulus -in "$private_key_file" 2>/dev/null)" ]; then
	certificate_valid=true
fi

if [ "$certificate_valid" != true ]; then
	temporary_certificate=$(mktemp "$destination/.certificate.XXXXXX")
	temporary_key=$(mktemp "$destination/.private-key.XXXXXX")
	trap 'rm -f "$temporary_certificate" "$temporary_key"' EXIT INT TERM
	openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 825 \
		-keyout "$temporary_key" -out "$temporary_certificate" \
		-config "$openssl_config" -extensions v3_req >/dev/null 2>&1
	mv "$temporary_certificate" "$certificate_file"
	mv "$temporary_key" "$private_key_file"
	trap - EXIT INT TERM
fi

chmod 600 "$environment_file"
chmod 640 "$token_file" "$private_key_file"
chmod 644 "$certificate_file"
