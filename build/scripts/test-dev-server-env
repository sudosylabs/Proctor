set -eu

if [ "$#" -ne 1 ]; then
	printf 'usage: %s DEV_SERVER_ENV_SCRIPT\n' "$0" >&2
	exit 2
fi

script=$1
fixture=$(mktemp -d "${TMPDIR:-/tmp}/proctor-dev-server-env.XXXXXX")
trap 'rm -rf "$fixture"' EXIT HUP INT TERM

printf '%s\n' 'PROCTOR_METRICS_BEARER_TOKEN=test-token' >"$fixture/secrets"
chmod 600 "$fixture/secrets"

PROCTOR_SERVER_LISTEN_ADDRESS=127.0.0.1:8065 \
	PROCTOR_SERVER_PUBLIC_URL=http://localhost:8065 \
	PROCTOR_SERVER_WEBAPP_DIRECTORY="$fixture/web'app" \
	PROCTOR_DATABASE_DATA_SOURCE=postgres://test \
	PROCTOR_CACHE_REDIS_ADDRESSES=127.0.0.1:6379 \
	PROCTOR_VFS_S3_ENDPOINT=127.0.0.1:9000 \
	PROCTOR_MAIL_SMTP_ADDRESS=127.0.0.1:1025 \
	PROCTOR_METRICS_LISTEN_ADDRESS=0.0.0.0:8067 \
	PROCTOR_METRICS_TLS_CERTIFICATE_FILE="$fixture/cert.pem" \
	PROCTOR_METRICS_TLS_PRIVATE_KEY_FILE="$fixture/key.pem" \
	"$script" "$fixture/secrets" "$fixture/server-environment"

output=$(sh -c 'set -a; . "$1"; set +a; printf "%s|%s|%s|%s" "$PROCTOR_SERVER_LISTEN_ADDRESS" "$PROCTOR_METRICS_BEARER_TOKEN" "$PROCTOR_VFS_BACKEND" "$PROCTOR_SERVER_WEBAPP_DIRECTORY"' sh "$fixture/server-environment")
if [ "$output" != "127.0.0.1:8065|test-token|s3|$fixture/web'app" ]; then
	printf 'unexpected bundled development server environment: %s\n' "$output" >&2
	exit 1
fi

printf 'dev-server-env tests passed\n'
