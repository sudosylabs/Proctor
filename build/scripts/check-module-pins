#!/bin/sh
# Copyright 2026 SudoSylabs
# SPDX-License-Identifier: AGPL-3.0-only

# Fail when the server's go.mod pins a repository module (packages/*) at a
# commit whose module tree differs from the working tree. go.work hides such
# drift: workspace builds use the local module while GOWORK=off builds and
# downstream consumers get the pinned, older code. The go.work replace
# directives must name the same versions, and the pinned commit must be an
# ancestor of HEAD: a pin to a commit that history rewriting dropped would
# leave downstream consumers fetching a revision the branch no longer has.
#
# The check needs the pinned commits in local history (a full clone). A commit
# cannot pin itself, so a change to packages/<module> is followed by a commit
# that bumps the pin to it; run this check on the branch tip, not on every
# commit.

set -eu

if [ "$#" -ne 1 ]; then
	printf 'usage: %s REPOSITORY_ROOT\n' "$0" >&2
	exit 2
fi

root=$1
module_prefix=github.com/sudosylabs/proctor/packages/
go_mod=$root/server/go.mod
go_work=$root/go.work
failed=0

fail() {
	printf '%s\n' "$*" >&2
	failed=1
}

suggest() {
	directory=$1
	module=$2
	latest=$(git -C "$root" log -1 --format=%H -- "$directory")
	if [ -z "$latest" ]; then
		return
	fi
	stamp=$(TZ=UTC git -C "$root" show -s --date=format-local:%Y%m%d%H%M%S --format=%cd "$latest")
	short=$(printf '%s' "$latest" | cut -c1-12)
	printf '  pin the newest commit touching %s: %s v0.0.0-%s-%s\n' "$directory" "$module" "$stamp" "$short" >&2
	printf '  (and update the matching go.work replace directive)\n' >&2
}

pins=$(awk -v prefix="$module_prefix" '
	$1 == "require" && index($2, prefix) == 1 { print $2, $3; next }
	index($1, prefix) == 1 { print $1, $2 }
' "$go_mod")
if [ -z "$pins" ]; then
	printf 'no %s* requirements found in %s\n' "$module_prefix" "$go_mod" >&2
	exit 1
fi

printf '%s\n' "$pins" | {
	while read -r module version; do
		name=${module#"$module_prefix"}
		directory=packages/$name
		if [ ! -f "$root/$directory/go.mod" ]; then
			fail "$module: no workspace module at $directory"
			continue
		fi

		case $version in
		v0.0.0-[0-9]*-*)
			stamp=$(printf '%s' "$version" | cut -d- -f2)
			revision=$(printf '%s' "$version" | cut -d- -f3)
			;;
		v*)
			stamp=
			revision=$directory/$version
			;;
		*)
			fail "$module: unrecognized version $version"
			continue
			;;
		esac

		commit=$(git -C "$root" rev-parse --verify --quiet "$revision^{commit}" || true)
		if [ -z "$commit" ]; then
			fail "$module $version: commit $revision is not in local history (fetch full history)"
			continue
		fi
		if ! git -C "$root" merge-base --is-ancestor "$commit" HEAD; then
			fail "$module $version: commit $revision is not an ancestor of HEAD (was history rewritten?)"
			suggest "$directory" "$module"
			continue
		fi
		if [ -n "$stamp" ]; then
			committed=$(TZ=UTC git -C "$root" show -s --date=format-local:%Y%m%d%H%M%S --format=%cd "$commit")
			if [ "$committed" != "$stamp" ]; then
				fail "$module $version: timestamp does not match commit time $committed"
				continue
			fi
		fi

		replaced=$(awk -v module="$module" '
			$1 == module && $3 == "=>" { print $2; exit }
			$1 == "replace" && $2 == module && $4 == "=>" { print $3; exit }
		' "$go_work")
		if [ -n "$replaced" ] && [ "$replaced" != "$version" ]; then
			fail "$module: go.work replaces $replaced but server/go.mod pins $version"
		fi

		untracked=$(git -C "$root" ls-files --others --exclude-standard -- "$directory")
		if ! git -C "$root" diff --quiet "$commit" -- "$directory" || [ -n "$untracked" ]; then
			fail "$module $version: pinned content differs from $directory"
			suggest "$directory" "$module"
		fi
	done
	exit "$failed"
}
